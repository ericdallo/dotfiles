{
    "$schema": "https://eca.dev/config.json",
    "defaultModel": "nubank-anthropic/opus-5.5",
    "includeParentAgentsFiles": true,
    "providers": {
        "nubank": {
            "api": "openai-responses",
            // "url": "${env:NULITELLM_API_URL}",
            // "key": "${env:NULITELLM_API_KEY}",
            "url": "${cmd:nu genai ai-gateway url}",
            "key": "${cmd:nu genai ai-gateway token}",
            "fetchModels": false,
            "models": {"openai/gpt-6-astra": {}}
        }, 
        "nubank-anthropic": {
            "api": "anthropic",
            // "url": "${env:NULITELLM_API_URL}",
            // "key": "${env:NULITELLM_API_KEY}",
            "url": "${cmd:nu genai ai-gateway url}",
            "key": "${cmd:nu genai ai-gateway token}",
            "cacheRetention": "long",
            "fetchModels": false,
            "retryRules": [
                {
                    "status": 401,
                    "errorPattern": "Authentication Error",
                    "label": "Flaky auth error"
                },
                {
                    "status": 504,
                    "label": "Gateway timeout"
                }
            ],
            "models": {
                "sonnet-5": {
                    "modelName": "anthropic/claude-sonnet-5"
                },
                "opus-5.5": {
                    "modelName": "anthropic/claude-opus-5-5"
                },
                "opus-5": {
                    "modelName": "anthropic/claude-opus-5"
                },
                "fable-5.1": {
                    "modelName": "anthropic/claude-fable-5-1"
                }
            }
        },
        "nubank-inference": {
            "api": "openai-chat",
            "url": "${env:NULITELLM_API_URL}",
            "key": "${env:NULITELLM_API_KEY}",
            "fetchModels": false,
            "models": {
                "bdc": {
                    "modelName": "inference/nubank-custom-model-original"
                }
            }
        },
        "aitunnel": {
            "api": "openai-chat",
            "url": "https://api.aitunnel.ru/v1",
            "key": "REDACTED",
            "fetchModels": false,
            "models": {"qwen3.5-397b-a17b": {}}
        },
        "openrouter": {
            "api": "openai-chat",
            "url": "https://openrouter.ai/api/v1",
            "key": "${env:OPENROUTER_API_KEY}",
            "models": {"z-ai/glm-4.5-air:free": {},
                       "arcee-ai/trinity-large-preview:free": {},
                       "openrouter/x-ai/grok-4.5": {}}
        }
        // "github-copilot": {
        //     "models": {
        //         "gpt-5-mini-non-stream": {
        //             "modelName": "gpt-5-mini",
        //             "extraPayload": {"stream": false}
        //         }
        //     }
        // },
        // "lmstudio": {
        //     "api": "openai-chat",
        //     "url": "http://localhost:1234",
        //     "completionUrlRelativePath": "/v1/chat/completions",
        //     "httpClient": {
        //         "version": "http-1.1"
        //     },
        //     "models": {
        //         "foo": {}
        //     }
        // }
        // "qwen": {
        //     "api": "openai-responses",
        //     "url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
        //     "key": "KEY-HERE"
        // }
    },
    "completion": {
        "model": "nubank/openai/gpt-6-astra",
        "responseEncoding": "udiff"
    },
    "chat": {
        "defaultTrust": true
        // "defaultTrust": false
    },
    "rewrite": {"model": "nubank/openai/gpt-5.3-codex"},
    "hooks": {
        "notify-finished": {
            "type": "postRequest",
            "visible": false,
            "actions": [
                {
                    "type": "shell",
                    "shell": "jq -e '.chat_id | startswith(\"subagent-\") | not' > /dev/null && canberra-gtk-play -i complete"
                }
            ]
        },
        "notify-approval": {
            "type": "preToolCall",
            "visible": false,
            "actions": [
                {
                    "type": "shell",
                    "shell": "jq -e '.approval == \"ask\"' > /dev/null && canberra-gtk-play -i message"
                }
            ]
        },
        "brepl-eval" : {
            "type" : "postToolCall",
            "visible": false,
            "matcher" : "eca__(write_file|edit_file)",
            "actions" : [ {
                "type" : "shell",
                "shell" : "/home/greg/dev/brepl/brepl eca eval"
            } ]
        },
        "brepl-session-end" : {
            "type" : "sessionEnd",
            "visible": false,
            "actions" : [ {
                "type" : "shell",
                "shell" : "/home/greg/dev/brepl/brepl eca session-end"
            } ]
        }
    },
    "toolCall": {
        "approval": {
            "allow": {"nu-mcp": {},
                      "glean": {},
                      "eca__shell_command": {"argsMatchers": {"command": ["gh.*"]}}}
        }
    },
    "agent": {
        "code-reviewer": {
            "mode": "subagent",
            "description": "Code reviewer for project changes, use it when asked to review code, present to user the final review before doing it.",
            "systemPrompt": "You are doing a code review, analyze the changes in git and be rigorous about the changes."
        }
    },
    "plugins": {
        "nubank": {
            "source": "https://github.com/nubank/ai-agents-plugins.git"
        },
        "install": [
        ]
    },
    "remote": {
        "enabled": true,
        "password": "foo"
    },
    "mcpServers": {
        "google-docs": {
            "url": "https://runlayer.nubankdev.com/api/v1/proxy/e9f3ddf1-7c88-4209-b6cc-4458f6a3c72c/mcp",
            "disabled": true
        },
        "google-sheets": {
            "url": "https://runlayer.nubankdev.com/api/v1/proxy/840eeef2-2389-450a-80a4-19ca536f7d72/mcp"
        },
        "nu-mcp-remote": {
            "url": "https://runlayer.nubankdev.com/api/v1/proxy/f97deb8a-9b7e-4aef-ab67-4ed8a854585a/mcp"
        },
        "slack": {
            "url": "https://runlayer.nubankdev.com/api/v1/proxy/8203c718-c1e5-46e6-9136-1434755f5c0e/mcp",
            "disabled": true
        },
        "glean": {
            "url": "https://runlayer.nubankdev.com/api/v1/proxy/820411d2-935b-462a-abe1-2e3dde3d3f02/mcp"
        },
        "figma": {
            "url": "https://mcp.figma.com/mcp",
            "clientName": "Claude Code",
            "disabled": true
        },
        "databricks-sql": {
            "url": "https://nubank-e2-general.cloud.databricks.com/api/2.0/mcp/sql",
            "clientId": "5e044bc8-2700-4763-8e76-b2f44faaf13b"
        },
        "whatsapp": {
            "command": "nix-shell",
            "args": [
                "-p",
                "uv",
                "python311",
                "--run",
                "UV_PYTHON_DOWNLOADS=never UV_PYTHON_PREFERENCE=only-system uv --directory /home/greg/dev/whatsapp-mcp/whatsapp-mcp-server run --default-index https://pypi.org/simple --python python3.11 main.py"
            ],
            "disabled": true
        },
        "miro": {
            "url": "https://mcp.miro.com/",
            "disabled": true 
        },
        "clojure-mcp-clj": {
            "disabled": true
        },
        "openai-image": {
            "command": "$HOME/dev/openai-gpt-image-mcp/start-mcp-nix.sh",
            "env": {
                "OPENAI_API_KEY":  "${env:NULITELLM_API_KEY}",
                "OPENAI_BASE_URL": "${env:NULITELLM_API_URL}/openai/v1"
            },
            "disabled": true
        },
        "pluggy": {
            "command": "node",
            "args": ["/home/greg/dev/pluggy-mcp/dist/index.js"],
            "env": {
                "PLUGGY_CLIENT_ID": "${env:PLUGGY_CLIENT_ID}",
                "PLUGGY_CLIENT_SECRET": "${env:PLUGGY_CLIENT_SECRET}"
            },
            "disabled": true
        },
        "chrome-devtools": {
            "command": "sh",
            "args": [
                "-c",
                "mkdir -p \"$npm_config_prefix/lib\" && exec npx -y chrome-devtools-mcp@latest --autoConnect --no-usage-statistics --no-performance-crux"
            ],
            "env": {
                "npm_config_prefix": "${env:HOME}/.npm-global",
                "npm_config_registry": "https://registry.npmjs.org/"
            },
            "disabled": true
        }
    }
    , "otlp": {
        "otel.exporter.otlp.metrics.protocol": "http/protobuf",
        "otel.exporter.otlp.metrics.endpoint": "https://prod-global-workstation-proxy.ist.nubank.world/api/telemetry/metrics"
    }
}

